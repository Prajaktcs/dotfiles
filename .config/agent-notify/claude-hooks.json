{
  "hooks": {
    "Stop": [{
      "hooks": [{ "type": "command", "command": "\"$HOME/.local/bin/agent-notify\" claude", "timeout": 10 }]
    }],
    "Notification": [{
      "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
      "hooks": [{ "type": "command", "command": "\"$HOME/.local/bin/agent-notify\" claude", "timeout": 10 }]
    }]
  }
}
